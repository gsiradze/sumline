# Copy to `.env` and fill in before a release build. `.env` is gitignored.
#
# Ads mode is chosen per build, not here: every build shows Google's test ads
# unless it is made with `npm run cap:sync:release` (which sets
# VITE_ADS_MODE=live). Do not put VITE_ADS_MODE in this file, or your own test
# builds will start serving live ads.

# AdMob — app IDs (also written into the native projects by `npm run patch:native`)
VITE_ADMOB_APP_ID_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
VITE_ADMOB_APP_ID_IOS=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy

# AdMob — ad unit IDs
VITE_ADMOB_REWARDED_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
VITE_ADMOB_REWARDED_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
VITE_ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
VITE_ADMOB_INTERSTITIAL_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
VITE_ADMOB_BANNER_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
VITE_ADMOB_BANNER_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy

# Shown in Settings. The privacy policy link is required by Google Play for an
# app that uses the advertising ID; a release build is refused without it.
VITE_PRIVACY_URL=https://example.com/privacy
VITE_SUPPORT_EMAIL=support@example.com

# Optional. Where the web version is hosted. When set, a shared result links to
# its level there (https://your-site/?level=37) instead of the store listing.
# VITE_WEB_URL=https://example.com
